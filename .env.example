# QueryDoc AI configuration. Copy to .env and edit; every value is optional.
# No API keys or secrets are required.

# QUERYDOC_DATA_DIR=./data/workspace
# QUERYDOC_LOG_LEVEL=INFO

# Ingestion
# QUERYDOC_MAX_UPLOAD_MB=50
# QUERYDOC_MAX_PAGES=1000
# QUERYDOC_ENABLE_OCR=false          # needs Tesseract installed

# Chunking (defaults selected by benchmarks/benchmark_relevance.py)
# QUERYDOC_CHUNK_STRATEGY=recursive  # fixed | recursive | sentence
# QUERYDOC_CHUNK_SIZE=1000
# QUERYDOC_CHUNK_OVERLAP=200

# Embeddings
# QUERYDOC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QUERYDOC_EMBEDDING_BATCH_SIZE=32
# QUERYDOC_EMBEDDING_DEVICE=cpu
# QUERYDOC_TORCH_THREADS=4

# Index
# QUERYDOC_INDEX_TYPE=flat           # flat | hnsw

# Retrieval
# QUERYDOC_TOP_K=5
# QUERYDOC_FETCH_K=30
# QUERYDOC_USE_HYBRID=true
# QUERYDOC_USE_RERANK=true
# QUERYDOC_RERANK_K=20
# QUERYDOC_RERANKER_DEVICE=auto      # auto | cpu | mps | cuda
# QUERYDOC_MIN_RELEVANCE_SCORE=0.25

# Generation
# QUERYDOC_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# QUERYDOC_LLM_DEVICE=auto
# QUERYDOC_MAX_NEW_TOKENS=256
# QUERYDOC_TEMPERATURE=0.0
# QUERYDOC_MAX_CONTEXT_TOKENS=2048

# Concurrency
# QUERYDOC_MAX_ACTIVE_GENERATIONS=1
# QUERYDOC_MAX_GENERATION_QUEUE=8
# QUERYDOC_GENERATION_TIMEOUT_S=120
