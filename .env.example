# QueryDoc AI configuration. Copy to .env and edit; every value is optional.
# No API keys or secrets are required for local use.

# QUERYDOC_DATA_DIR=./data/workspace
# QUERYDOC_LOG_LEVEL=INFO

# Ingestion
# QUERYDOC_MAX_UPLOAD_MB=50
# QUERYDOC_MAX_PAGES=1000
# QUERYDOC_ENABLE_OCR=false          # needs Tesseract installed

# Chunking (defaults selected by benchmarks/benchmark_relevance.py)
# QUERYDOC_CHUNK_STRATEGY=recursive  # fixed | recursive | sentence
# QUERYDOC_CHUNK_SIZE=1000
# QUERYDOC_CHUNK_OVERLAP=200

# Embeddings
# QUERYDOC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QUERYDOC_EMBEDDING_BATCH_SIZE=32
# QUERYDOC_EMBEDDING_DEVICE=cpu
# QUERYDOC_TORCH_THREADS=4

# Index
# QUERYDOC_INDEX_TYPE=flat           # flat | hnsw

# Retrieval
# QUERYDOC_TOP_K=5
# QUERYDOC_FETCH_K=30
# QUERYDOC_USE_HYBRID=true
# QUERYDOC_USE_RERANK=true
# QUERYDOC_RERANK_K=20
# QUERYDOC_RERANKER_DEVICE=auto      # auto | cpu | mps | cuda
# QUERYDOC_MIN_RELEVANCE_SCORE=0.25

# Generation
# QUERYDOC_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # or Qwen/Qwen2.5-0.5B-Instruct (low memory)
# QUERYDOC_LLM_DEVICE=auto
# QUERYDOC_MAX_NEW_TOKENS=256
# QUERYDOC_TEMPERATURE=0.0
# QUERYDOC_MAX_CONTEXT_TOKENS=2048

# Concurrency
# QUERYDOC_MAX_ACTIVE_GENERATIONS=1
# QUERYDOC_MAX_GENERATION_QUEUE=8
# QUERYDOC_GENERATION_TIMEOUT_S=120

# API server (backend/app/core/config.py)
# QUERYDOC_DATABASE_URL=sqlite:///./data/workspace/querydoc.db
# QUERYDOC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# QUERYDOC_REQUEST_TIMEOUT_S=60
# QUERYDOC_STREAM_TIMEOUT_S=300
# QUERYDOC_INGESTION_WORKERS=1
# QUERYDOC_LOAD_MODELS_ON_STARTUP=true

# Accounts (off = local single-user mode, no authentication)
# QUERYDOC_AUTH_ENABLED=false
# QUERYDOC_SIGNUP_ENABLED=true
# QUERYDOC_ADMIN_EMAILS=["you@example.com"]   # may change server-wide settings
# QUERYDOC_SESSION_DAYS=14
# QUERYDOC_COOKIE_SECURE=false                # true behind HTTPS
# QUERYDOC_COOKIE_SAMESITE=lax                # none when embedded in an iframe (needs HTTPS)
# QUERYDOC_MAX_DOCUMENTS_PER_USER=20
# QUERYDOC_MAX_STORAGE_MB_PER_USER=200
# QUERYDOC_CHAT_PER_MINUTE=10

# Durable workspace on hosts without a persistent disk (needs HF_TOKEN with write access)
# QUERYDOC_HF_BACKUP_REPO=<user>/querydoc-ai-data   # private Hugging Face dataset
# QUERYDOC_HF_BACKUP_INTERVAL_S=120
